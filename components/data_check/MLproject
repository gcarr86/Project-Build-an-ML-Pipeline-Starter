name: data_check
env_manager: local
# conda_env: conda.yml

entry_points:
  main:
    parameters:
      reference_artifact:
        type: string

      sample_artifact:
        type: string

      ks_alpha:
        type: float

      kl_threshold:
        type: float

    command: >
      python run.py
      --reference_artifact {reference_artifact}
      --sample_artifact {sample_artifact}
      --ks_alpha {ks_alpha}
      --kl_threshold {kl_threshold}